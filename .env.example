# ── Supabase ──────────────────────────────────────────────────────
# Obtenha em: Project Settings > API

# URL do projeto
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Chave pública (usada no frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# Chave secreta (usada apenas nas API Routes — NUNCA expor no frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5c...

# Backup diário do banco (./backup.sh instalar). Supabase > botão Connect >
# Connection String > Session pooler (porta 5432), com a senha do banco no
# lugar de [YOUR-PASSWORD]. Só o script de backup da VPS usa.
# SUPABASE_DB_URL="postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Aplicação ─────────────────────────────────────────────────────

# URL pública da aplicação (usada em webhooks e links gerados pelo servidor)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Configurações da Vórtice (agora no Painel Master > Plataforma) ──
# App da Meta (META_APP_ID, META_APP_SECRET, META_LOGIN_CONFIG_ID,
# META_WA_CONFIG_ID), token do webhook do WhatsApp e IA padrão (Gemini /
# Ollama) são editados pela tela, sem deploy. As variáveis abaixo
# continuam valendo só como reserva para campo vazio no painel.

# ── Google Gemini (Atendente com IA e legendas das Redes Sociais) ─────
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# ── IA local (Ollama na própria VPS) ────────────────────────────────
# Com AI_PROVIDER=ollama, Automações e legendas usam a IA local; se ela
# falhar, o Gemini acima (se houver chave) responde no lugar. Notas
# fiscais continuam no Gemini quando ele existe.
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_TIMEOUT_SECONDS=180

# ── WhatsApp — Meta Cloud API (oficial) ─────────────────────────────
# Ver WHATSAPP_API_DOCS.md para o passo a passo completo
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxx...
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210987654
WHATSAPP_WEBHOOK_VERIFY_TOKEN=defina-um-token-secreto-aqui
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxx

# ── WhatsApp — WhatsApp Web (gratuito, via Baileys) ─────────────────
# Diretório persistente da sessão. Em produção, aponte para um volume
# que sobreviva a redeploys (o padrão é .whatsapp-session/ no projeto).
WHATSAPP_WEB_SESSION_PATH=.whatsapp-session
# Religa sozinho, ao subir o servidor, os WhatsApp Web já pareados (padrão: ligado).
# WHATSAPP_WEB_AUTOSTART=false
# Tempo máximo (ms) para cada tentativa de conexão do WhatsApp Web (padrão: 45000).
# WHATSAPP_WEB_CONNECT_TIMEOUT_MS=45000

# ── Redes Sociais (Instagram/Facebook via app da Meta) ──────────────
# Passo a passo: Central de Ajuda → "Instagram & Facebook".
META_APP_ID=
META_APP_SECRET=
# Liga o agendador de posts. Só tem efeito com `npm start` (produção):
# nunca roda no `npm run dev` nem nos previews da Vercel.
CONTENT_SCHEDULER_ENABLED=true
# Opcionais:
# Versão da Graph API usada em todo o sistema (WhatsApp oficial, Redes Sociais, modelos).
# META_GRAPH_VERSION=v23.0
# META_OAUTH_REDIRECT_URI=https://app.vorticetecnologia.com.br/api/social/oauth/callback
# META_LOGIN_CONFIG_ID=
# Botão "Conectar com Facebook" do WhatsApp oficial (cadastro incorporado):
# ID da configuração criada no app da Meta (Login do Facebook para Empresas
# > Configurações, tipo WhatsApp Embedded Signup). Sem ele, as empresas usam
# o formulário manual.
# META_WA_CONFIG_ID=

# ── Cobrança automática (Asaas) ─────────────────────────────────────
# Prefira configurar em Painel Master > Plataforma. Se preencher aqui,
# vale enquanto o campo do painel estiver vazio.
# ASAAS_ENV=sandbox            # sandbox (teste) ou production
# ASAAS_API_KEY=$aact_hmlg_... # teste começa com $aact_hmlg_, produção com $aact_prod_
# ASAAS_WEBHOOK_TOKEN=         # 32+ caracteres; o mesmo cadastrado no webhook do Asaas

# ── E-mail da Vórtice (SMTP) ────────────────────────────────────────
# Manda o código de 6 dígitos que confirma o e-mail no cadastro do teste
# grátis. Prefira configurar em Painel Master > Plataforma. Sem isto, o
# cadastro segue sem confirmar o e-mail. Gmail: use uma "senha de app".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                 # 587 (STARTTLS) ou 465 (SSL)
# SMTP_USER=nao-responda@suaempresa.com.br
# SMTP_PASSWORD=
# SMTP_FROM="Vórtice Tecnologia <nao-responda@suaempresa.com.br>"

# ── Twilio (Discador) ────────────────────────────────────────────────
# Opcional e antigo: cada empresa conecta a PRÓPRIA conta Twilio em
# Integrações > Discador. Estas variáveis só valem para a empresa da
# Vórtice enquanto ela não conectar pela tela.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15551234567
